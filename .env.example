# Copie para .env e preencha. O .env não é versionado.

# Chave de acesso à Evolution API (gere uma aleatória, ex: openssl rand -hex 32)
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria

# Senhas do Postgres interno (bancos da Evolution API e do Keycloak)
EVOLUTION_POSTGRES_PASSWORD=troque-por-uma-senha
KEYCLOAK_DB_PASSWORD=troque-por-outra-senha

# URL pela qual o painel é acessado no navegador (sem barra no final).
# Ex: http://localhost:8088, http://raspberrypi:8088 (Tailscale) ou https://pelada.seudominio.com (Cloudflare Tunnel)
AABB_URL_PUBLICA=http://localhost:8088

# Console de administração do Keycloak (<URL pública>/auth/admin)
KEYCLOAK_ADMIN_USUARIO=keycloak-admin
KEYCLOAK_ADMIN_SENHA=troque-por-uma-senha-forte

# Senha inicial do usuário "admin" do painel (o Keycloak pede para trocar no primeiro login)
AABB_PAINEL_SENHA_INICIAL=troque-no-primeiro-login

# JID do grupo oficial do WhatsApp (ex: 120363000000000000@g.us).
# Deixe vazio na primeira subida: o backend registra os webhooks recebidos e o JID aparece no log.
AABB_GRUPO_JID=

# Imagens do sistema no Docker Hub (usuário e versão). "latest" é a última publicada.
AABB_IMAGENS=jadsonmd
AABB_VERSAO=latest
